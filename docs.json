{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Final",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "pages": [
      {
        "group": "Git",
        "pages": [
          "git/index",
          "git/clone",
          "git/manage"
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/git/quickstart",
      "destination": "/git"
    },
    {
      "source": "/git/reference",
      "destination": "/git"
    }
  ],
  "logo": {
    "light": "/logo/final-light.svg",
    "dark": "/logo/final-dark.svg"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  }
}
