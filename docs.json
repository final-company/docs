{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Final",
  "colors": {
    "primary": "#000",
    "light": "#000",
    "dark": "#fff"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "pages": [
      {
        "group": "Git",
        "pages": [
          "git/index",
          "git/clone",
          "git/manage"
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/git/quickstart",
      "destination": "/git"
    },
    {
      "source": "/git/reference",
      "destination": "/git"
    }
  ],
  "logo": {
    "light": "/logo/final-light.svg",
    "dark": "/logo/final-dark.svg",
    "href": "https://final.ai/?ref=docs"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@final.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/final_company",
      "linkedin": "https://www.linkedin.com/company/final-ai"
    }
  },
  "fonts": {
    "heading": {
      "family": "Inter"
    },
    "body": {
      "family": "Inter"
    }
  }
}
